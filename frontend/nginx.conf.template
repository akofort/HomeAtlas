# WebSocket upgrade passthrough (interactive consoles, see main.py's /api/ws/ routes). An
# ordinary HTTP request sends no Upgrade header, so $http_upgrade is empty and this maps to
# "close" -- Connection: close on a normal request is correct and harmless; it only becomes
# "upgrade" when the client actually asked to upgrade.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${HOMEATLAS_PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Both containers run on the host network, so the backend is reachable on loopback rather
    # than by compose service name. Port must match the backend's HOMEATLAS_API_PORT.
    location /api/ {
        proxy_pass http://127.0.0.1:${HOMEATLAS_API_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # A chat turn can run several tool calls plus an LLM round trip; the default 60s cuts
        # those off mid-answer.
        proxy_read_timeout 300s;
    }

    # Interactive consoles (SSH/Docker exec) are long-lived, not bounded request/response calls --
    # the 300s read timeout above would cut off a console someone is still typing in. A longer,
    # more specific prefix location; nginx matches it ahead of /api/ regardless of block order.
    location /api/ws/ {
        proxy_pass http://127.0.0.1:${HOMEATLAS_API_PORT}/api/ws/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    # Single-page app: every unknown path is a client-side route, not a 404.
    location / {
        try_files $uri /index.html;
    }
}
